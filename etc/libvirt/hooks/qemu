#!/bin/bash

# Expose services of the nested exordos core VM on the node addresses.
# The bootstrap domain is named `<prefix><uuid8>-exordos-core-bootstrap`
# by the exordos CLI, hence the suffix match.

case "${1}" in
*exordos-core-bootstrap)

    GUEST_IP=10.20.0.2
    # External interface of the node (parent realm network side)
    EXT_IF=$(ip route show default | awk '{print $5; exit}')

    forward() {
        local proto=$1 host_port=$2 guest_port=$3 action=$4

        if [ "$action" = "delete" ]; then
            /sbin/iptables -D FORWARD -p $proto -d $GUEST_IP --dport $guest_port -j ACCEPT
            /sbin/iptables -t nat -D PREROUTING -i $EXT_IF -p $proto --dport $host_port -j DNAT --to $GUEST_IP:$guest_port
        else
            /sbin/iptables -I FORWARD 1 -p $proto -d $GUEST_IP --dport $guest_port -j ACCEPT
            /sbin/iptables -t nat -I PREROUTING 1 -i $EXT_IF -p $proto --dport $host_port -j DNAT --to $GUEST_IP:$guest_port
        fi
    }

    apply() {
        local action=$1

        # core api
        forward tcp 11010 11010 "$action"
        # private DNS
        forward tcp 53 5300 "$action"
        forward udp 53 5300 "$action"
    }

    if [ "${2}" = "stopped" ] || [ "${2}" = "reconnect" ]; then
        apply delete
    fi
    if [ "${2}" = "start" ] || [ "${2}" = "reconnect" ]; then
        apply insert
    fi

    ;;
esac
